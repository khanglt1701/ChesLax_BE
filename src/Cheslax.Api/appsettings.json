{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "Provider": "SqlServer"
  },
  "ConnectionStrings": {
    "Default": "Server=.\\SQLEXPRESS;Database=Cheslax;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=True"
  },
  "Matchmaking": {
    "KFactor": 32,
    "ReconnectGraceSeconds": 90,
    "ExpandAfterSeconds": 30,
    "ExpandEverySeconds": 10,
    "ExpandBy": 50,
    "MaxSpread": 800,
    "Bands": [
      { "AfterSeconds": 0, "MaxSpread": 100 },
      { "AfterSeconds": 10, "MaxSpread": 200 },
      { "AfterSeconds": 20, "MaxSpread": 300 }
    ]
  },
  "Cors": {
    "Origins": [
      "http://localhost:5173",
      "http://127.0.0.1:5173"
    ]
  }
}
