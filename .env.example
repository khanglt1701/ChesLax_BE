# Copy to .env and fill in. Never commit real secrets.
# Docker Compose reads this file automatically when present.

POSTGRES_DB=cheslax
POSTGRES_USER=cheslax
POSTGRES_PASSWORD=change-me

# Must match POSTGRES_* above. Used by the API container.
ConnectionStrings__Default=Host=postgres;Port=5432;Database=cheslax;Username=cheslax;Password=change-me

Database__Provider=Npgsql
# Production: leave false and run `docker compose run --rm api --migrate` once per release.
Database__ApplyMigrations=false

ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://+:8080

# Comma-separated public origins. Same-origin Nginx (/api) still needs the site origin for credentialed CORS if the API is called cross-origin.
# When Nginx serves the SPA and proxies /api on the same host, list that HTTPS origin.
Cors__Origins=https://play.example.com
